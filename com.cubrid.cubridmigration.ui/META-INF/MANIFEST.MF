Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: CUBRID Migration Toolkit UI Plug-in
Bundle-SymbolicName: com.cubrid.cubridmigration.ui;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Activator: com.cubrid.cubridmigration.ui.MigrationUIPlugin
Bundle-Vendor: CUBRID
Bundle-ActivationPolicy: lazy
Bundle-RequiredExecutionEnvironment: JavaSE-1.8
Bundle-Localization: plugin
Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.eclipse.ui.forms,
 com.cubrid.cubridmigration.core,
 com.cubrid.common.configuration,
 rome.rome,
 org.jdom,
 it.sauronsoftware.cron4j,
 javax.activation,
 org.apache.commons.collections,
 org.apache.log4j,
 org.apache.commons.lang,
 com.jcraft.jsch,
 org.apache.hadoop.core
Bundle-ClassPath: .
Export-Package: com.cubrid.common.ui.common.notice,
 com.cubrid.common.ui.handler,
 com.cubrid.cubridmigration.ui,
 com.cubrid.cubridmigration.ui.common,
 com.cubrid.cubridmigration.ui.preference,
 com.cubrid.cubridmigration.ui.product,
 com.cubrid.cubridmigration.ui.script
