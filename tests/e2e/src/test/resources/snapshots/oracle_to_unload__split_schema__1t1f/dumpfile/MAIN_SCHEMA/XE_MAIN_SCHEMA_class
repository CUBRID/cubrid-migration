CREATE TABLE [MAIN_SCHEMA].[e2e_binary_types](
[id] numeric(10,0),
[raw_col] bit varying(128),
[blob_col] bit varying(1073741823)
)
;
CREATE TABLE [MAIN_SCHEMA].[e2e_customer](
[customer_id] numeric(10,0),
[customer_code] char(4) NOT NULL COMMENT 'business key',
[customer_name] varchar(100) NOT NULL,
[customer_alias] varchar(60) COMMENT '고객 별칭 (다국어 검증)',
[status] char(1),
[credit_limit] numeric(15,2),
[created_on] datetime,
[updated_on] datetime
)
;
CREATE TABLE [MAIN_SCHEMA].[e2e_employee](
[employee_id] numeric(10,0),
[manager_id] numeric(10,0) COMMENT 'Self-FK to direct manager',
[emp_name] varchar(100) NOT NULL,
[hired_on] datetime
)
;
CREATE TABLE [MAIN_SCHEMA].[e2e_numeric_types](
[id] numeric(10,0),
[integer_col] int,
[decimal_col] numeric(20,4),
[number_p0_col] numeric(38,0),
[number_ps_col] numeric(20,6),
[number_round_col] numeric(10,0),
[number_any_col] numeric(38,15),
[float_col] double,
[real_col] double,
[binary_float_col] float,
[binary_double_col] double
)
;
CREATE TABLE [MAIN_SCHEMA].[e2e_oracle_locator_types](
[id] numeric(10,0),
[rowid_col] varchar(64),
[urowid_col] varchar(4000)
)
;
CREATE TABLE [MAIN_SCHEMA].[e2e_order](
[order_id] numeric(10,0),
[customer_id] numeric(10,0) NOT NULL,
[order_no] varchar(30),
[order_status] varchar(20),
[total_amount] numeric(18,2),
[ordered_at] datetime,
[settled_at] datetime,
