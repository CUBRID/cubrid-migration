CREATE TABLE [DBO].[e2e_binary_types](
[id] int,
[binary_col] bit(32),
[varbinary_col] bit varying(128)
)
;
CREATE TABLE [DBO].[e2e_customer](
[customer_id] int,
[customer_code] char(4) NOT NULL,
[customer_name] varchar(100) NOT NULL COMMENT 'business customer name',
[customer_alias] varchar(60),
[status] char(1),
[credit_limit] numeric(15,2),
[created_on] date,
[updated_on] date
)
;
CREATE TABLE [DBO].[e2e_employee](
[employee_id] int,
[manager_id] int,
[emp_name] varchar(100) NOT NULL,
[hired_on] date
)
;
CREATE TABLE [DBO].[e2e_numeric_types](
[id] int,
[bit_col] short,
[tinyint_col] short,
[smallint_col] short,
[int_col] int,
[bigint_col] bigint,
[decimal_col] numeric(20,4),
[numeric_col] numeric(18,2),
[money_col] numeric(19,4),
[smallmoney_col] numeric(10,4),
[float_col] float,
[real_col] float
)
;
CREATE TABLE [DBO].[e2e_order](
[order_id] int,
[customer_id] int NOT NULL,
[order_no] varchar(30),
[order_status] varchar(20),
[total_amount] numeric(18,2),
[ordered_at] date,
[settled_at] date,
[source_comment] varchar(200)
)
;
CREATE TABLE [DBO].[e2e_order_line](
[order_id] int,
[line_no] int,
[sku] varchar(30),
[qty] int,
[unit_price] numeric(15,2),
[line_note] varchar(200)
)
;
CREATE TABLE [DBO].[e2e_temporal_types](
[id] int,
[date_col] date,
[datetime_col] datetime,
[smalldatetime_col] datetime
)
;
CREATE TABLE [DBO].[e2e_text_types](
[id] int,
[char_col] char(10),
[varchar_col] varchar(100),
[nchar_col] char(10),
[nvarchar_col] varchar(100)
)
;
